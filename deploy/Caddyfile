# Caddy serves the site over HTTPS and renews the certificate automatically.
#
# The site lives at www.paxvelo.club. The old paxvelo.cc addresses (used
# before the move from Squarespace, and in emails sent then) redirect to it.
# During the move itself, deploy/Caddyfile.during-move serves both names
# without redirecting until paxvelo.club's certificate is in place.
#
# Cloudflare: the site can sit behind Cloudflare's CDN (DNS record "Proxied").
# Visitors then reach the server through Cloudflare, so Caddy takes each
# visitor's real address from Cloudflare's CF-Connecting-IP header, but only
# on connections that come from Cloudflare's own addresses (below, from
# https://www.cloudflare.com/ips/), so nobody else can fake it. The site's
# spam limits and the address kept with each waiver depend on it. This needs
# Caddy 2.7 or newer (deploy/cloudflare-prep.sh installs it).
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

www.paxvelo.club {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080 {
		# One address, the visitor's: the site reads the last one it's given.
		header_up X-Forwarded-For {client_ip}
	}
	header Strict-Transport-Security "max-age=31536000"
}

# Send the bare domain to www.
paxvelo.club {
	header Strict-Transport-Security "max-age=31536000"
	redir https://www.paxvelo.club{uri} permanent
}

# The old addresses from before the move.
paxvelo.cc, www.paxvelo.cc {
	header Strict-Transport-Security "max-age=31536000"
	redir https://www.paxvelo.club{uri} permanent
}

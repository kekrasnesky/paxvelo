# Used only while paxvelo.club moves off Squarespace: serves the site at both
# www.paxvelo.cc and www.paxvelo.club, with no redirect between them, so
# nothing breaks while DNS spreads and Caddy gets paxvelo.club's certificate.
# Once https://www.paxvelo.club works, install deploy/Caddyfile instead and
# delete this file. Cloudflare notes: see deploy/Caddyfile.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

www.paxvelo.club, www.paxvelo.cc {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-For {client_ip}
	}
	header Strict-Transport-Security "max-age=31536000"
}

paxvelo.club {
	header Strict-Transport-Security "max-age=31536000"
	redir https://www.paxvelo.club{uri} permanent
}

paxvelo.cc {
	header Strict-Transport-Security "max-age=31536000"
	redir https://www.paxvelo.cc{uri} permanent
}
